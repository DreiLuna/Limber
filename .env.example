# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=limber
POSTGRES_PASSWORD=limber
POSTGRES_DB=limber
DATABASE_URL=postgresql+psycopg://limber:limber@db:5432/limber
JWT_SECRET=replace-with-a-long-random-string-at-least-32-bytes
# M5: AI planning. Leave blank to always use the rule-based fallback.
LLM_PROVIDER=
LLM_API_KEY=
# Optional Gmail SMTP reminders (sent during the 24 hours before a session).
# Enable 2-Step Verification and use a Google App Password, not your account password.
EMAIL_REMINDERS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
APP_BASE_URL=http://localhost:5173
EMAIL_REMINDER_POLL_SECONDS=60
